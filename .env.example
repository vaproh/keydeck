# Copy to .env and fill. Keep .env out of git.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_BASE_URL=https://license.example.com

LICENSE_ADMIN_PASSWORD_HASH=
LICENSE_ADMIN_TOTP_SECRET=
ADMIN_SERVICE_TOKEN=
LICENSE_DOWNLOAD_SECRET=

# One pair per product. Slug is upper-cased with - and . replaced by _.
LICENSE_SIGNING_KEY_REORCHESTRA=
UPDATE_SIGNING_KEY_REORCHESTRA=

# Example second product:
# LICENSE_SIGNING_KEY_MY_APP=
# UPDATE_SIGNING_KEY_MY_APP=

PORT_LICENSE=8080
PORT_OTA=8081
PORT_ADMIN=8082
LICENSE_DOMAIN=license.example.com
OTA_DOMAIN=ota.example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_ALLOW=203.0.113.10/32
