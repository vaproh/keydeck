# Copy to .env and fill every value before starting the stack.

POSTGRES_DB=keydeck
POSTGRES_USER=keydeck
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://keydeck:change-me@db:5432/keydeck?sslmode=disable

# Public license domain, OTA domain, and private admin domain.
LICENSE_DOMAIN=license.example.com
OTA_DOMAIN=ota.example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_ALLOW=203.0.113.10/32

PORT_LICENSE=8080
PORT_OTA=8081
PORT_ADMIN=8082
PUBLIC_BASE_URL=https://ota.example.com
ARTIFACTS_DIR=/data/artifacts
COOKIE_SECURE=true
LOG_LEVEL=info

# Generate with: go run ./cmd/keydeck passwd
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_ACTOR=admin

# Generate with: go run ./cmd/keydeck keygen <product-slug>
LICENSE_SIGNING_KEY_REORCHESTRA=
UPDATE_SIGNING_KEY_REORCHESTRA=

# Used to sign short-lived OTA download URLs.
DOWNLOAD_SECRET=
