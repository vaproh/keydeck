# Copy to .env and fill every value before starting the stack.

POSTGRES_DB=keydeck
POSTGRES_USER=keydeck
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://keydeck:change-me@db:5432/keydeck?sslmode=disable

# Public license domain, OTA domain, and private admin domain.
LICENSE_DOMAIN=license.example.com
OTA_DOMAIN=ota.example.com
ADMIN_DOMAIN=admin.example.com
ADMIN_ALLOW=203.0.113.10/32

PORT_LICENSE=8080
PORT_OTA=8081
PORT_ADMIN=8082
PUBLIC_BASE_URL=https://ota.example.com
ARTIFACTS_DIR=/data/artifacts
SIGNING_KEYS_DIR=/data/keys
COOKIE_SECURE=true
LOG_LEVEL=info

# Generate with: go run ./cmd/keydeck passwd
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_ACTOR=admin

# Cloudflare Turnstile. The public site key is served to the login page at runtime.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=admin.example.com

# Optional first-run API token. Generate a strong random value, use it once to
# create a scoped agent token in /admin/access, then remove it and restart.
#   openssl rand -base64 48
BOOTSTRAP_ADMIN_TOKEN=

# Per-product Ed25519 private seeds. The server starts empty; add these after
# the product exists. Generate with:
#   go run ./cmd/keydeck keygen <product-slug>
# Register the printed public keys on the product in the admin panel.
# Never commit, ship, or rotate these casually.
# LICENSE signs activation leases. UPDATE signs OTA manifests.
# Optional overrides. When omitted, Keydeck generates and stores seeds in SIGNING_KEYS_DIR.
# LICENSE_SIGNING_KEY_REORCHESTRA=
# UPDATE_SIGNING_KEY_REORCHESTRA=

# Used to sign short-lived OTA download URLs.
DOWNLOAD_SECRET=

# Watchtower Docker API version. Raise if the daemon rejects 1.44.
DOCKER_API_VERSION=1.44

# Interface for local health checks / HAProxy. Use 0.0.0.0 only with a firewall.
KEYDECK_BIND_IP=127.0.0.1
